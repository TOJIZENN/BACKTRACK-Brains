# OANDA v20 REST API — used ONLY for historical market data. No orders are ever placed.
# Create a personal access token in your OANDA account (practice accounts work fine).
OANDA_API_KEY=your_api_key
# Not needed for candle data; reserved for future account-scoped lookups.
OANDA_ACCOUNT_ID=your_account_id
# Practice: https://api-fxpractice.oanda.com   Live: https://api-fxtrade.oanda.com
OANDA_BASE_URL=https://api-fxpractice.oanda.com

# Optional server settings
PORT=4000
# Directory for cached historical candles (relative to server/)
CACHE_DIR=cache
# OANDA request timeout in milliseconds
OANDA_TIMEOUT_MS=15000
