# Market data is used ONLY for historical candles. No orders are ever placed anywhere.

# Which provider to load candles from: twelvedata (default) or oanda
DATA_PROVIDER=twelvedata

# --- Twelve Data (https://twelvedata.com) ---
# Get a free key at https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=your_twelve_data_api_key
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# --- OANDA (optional, only when DATA_PROVIDER=oanda) ---
OANDA_API_KEY=your_api_key
# Not needed for candle data; reserved for future account-scoped lookups.
OANDA_ACCOUNT_ID=your_account_id
# Practice: https://api-fxpractice.oanda.com   Live: https://api-fxtrade.oanda.com
OANDA_BASE_URL=https://api-fxpractice.oanda.com

# Optional server settings
PORT=4000
# Directory for cached historical candles (relative to server/); one sub-folder per provider
CACHE_DIR=cache
# Market-data request timeout in milliseconds
UPSTREAM_TIMEOUT_MS=15000
